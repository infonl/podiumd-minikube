#!/usr/bin/env python3
"""Flushes the shared Redis: every DB (FLUSHALL), or one with --db. DBs mix caches and Celery queues."""

import argparse
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib import process
from lib import services


def main() -> None:
    """Parses --db and flushes."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--db", type=int, help="flush only this DB number")
    services.flush_redis(parser.parse_args().db)


process.main(main)
