#!/usr/bin/env bash
# Every other file in bin/ links here: `bin/<command> ARGS` runs `podiumd-minikube <command> ARGS`.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
cli=$root/.venv/bin/podiumd-minikube
if [[ ! -x "$cli" ]]; then
    cli=$(command -v podiumd-minikube) || {
        echo "ERROR: podiumd-minikube is not installed: run python3 -m venv .venv && .venv/bin/pip install -e '.[dev]' in $root" >&2
        exit 1
    }
fi
exec "$cli" "$(basename "$0")" "$@"
