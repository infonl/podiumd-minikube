#!/usr/bin/env python3
"""Starts minikube tunnel in the background and waits for the edge's external IP; `stop` stops it.

sudo asks for your password in the foreground (for the route). Do not run with sudo.
"""

import argparse
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib import process
from lib import tunnel


def main() -> None:
    """Parses the arguments and starts or stops the tunnel."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("action", nargs="?", choices=["start", "stop"], default="start", help="default: start")
    if parser.parse_args().action == "stop":
        tunnel.stop_tunnel()
    else:
        tunnel.setup_tunnel()


process.main(main)
