#!/usr/bin/env python3
"""Empties the podiumd-minikube namespace and its cluster-wide leftovers, after confirmation."""

import argparse
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib import process
from lib import teardown


def main() -> int:
    """Parses --yes and resets."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    return teardown.reset_namespace(yes=parser.parse_args().yes)


process.main(main)
