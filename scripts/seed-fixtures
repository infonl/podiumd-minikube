#!/usr/bin/env python3
"""Loads the objecten/objecttypen demo data unless already present (deploy runs this too)."""

import argparse
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib import chart
from lib import kube
from lib import process
from lib import seed


def main() -> None:
    """Parses the (empty) arguments and seeds."""
    argparse.ArgumentParser(description=__doc__).parse_args()
    kube.require_minikube_context()
    seed.seed_fixtures(merged=chart.objecten_shape().merged)


process.main(main)
