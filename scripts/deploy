#!/usr/bin/env python3
"""Renders this chart and applies it to the minikube cluster; extra arguments (--set x=y) go to helm."""

import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib import deploy
from lib import process

process.main(lambda: deploy.main(sys.argv[1:], __doc__ or ""))
